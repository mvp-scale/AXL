 "terms": [
  {
   "id": "axl:term/adapt@0.1",
   "term": "adapt",
   "resolution": "tool-backed",
   "patterns": [
    {
     "id": "axl:pattern/reachable-targets@0.1",
     "name": "Tap targets are at least 44x44px",
     "claim": "clm_0477",
     "status": "verified",
     "tool": "axl craft checks",
     "command": "node axl/tools/runners/craft.js axl/demo/polished.html 1440 spacing-4,target-44",
     "pass": "every visible interactive element measures at least 44x44 CSS px",
     "parameter": "source: 44x44 in both sources"
    },
    {
     "id": "axl:pattern/reflow@0.1",
     "name": "Content fits a 320px-wide screen",
     "claim": "clm_0479",
     "status": "single-source",
     "tool": "axl craft checks",
     "command": "node axl/tools/runners/craft.js axl/demo/polished.html 320 reflow-320",
     "pass": "no visible element's right edge is past the 320px viewport",
     "parameter": "source: 320 CSS px"
    },
    {
     "id": "axl:pattern/text-size-floor@0.1",
     "name": "Text is at least 14px (body 16px)",
     "claim": "clm_0481",
     "status": "single-source",
     "tool": "axl craft checks",
     "command": "node axl/tools/runners/craft.js axl/demo/fixture-typeset.html 1440 body-16,leading-1.5",
     "pass": "no checked text element computes below 14px",
     "parameter": "source: 16px body, 14px secondary; the check enforces the 14px floor only"
    }
   ]
  },
  {
   "id": "axl:term/animate@0.1",
   "term": "animate",
   "resolution": "tool-backed",
   "patterns": [
    {
     "id": "axl:pattern/motion-duration@0.1",
     "name": "State-change motion is 500ms or shorter",
     "claim": "clm_0482",
     "status": "single-source",
     "tool": "axl craft checks",
     "command": "node axl/tools/runners/craft.js axl/demo/fixture-motion-unguarded.html 1440 duration-500",
     "pass": "no element has a transition-duration above 500ms",
     "parameter": "source: duration bands; AXL default: 500ms cap for everything"
    },
    {
     "id": "axl:pattern/reduced-motion@0.1",
     "name": "Motion gives way to prefers-reduced-motion",
     "claim": "clm_0483",
     "status": "verified",
