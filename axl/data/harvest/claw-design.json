   "file": "h_claw-design__4.txt",
   "section": "no-fixed-font-size",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "HTML 嵌套不超过 8 层",
   "file": "h_claw-design__4.txt",
   "section": "max-nesting-depth",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Dense text blocks reduce readability and presentation rhythm.",
   "file": "h_claw-design__5.txt",
   "section": "anti-pattern-text-density",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Split long sections into more pages and keep each section focused on one idea.",
   "file": "h_claw-design__5.txt",
   "section": "anti-pattern-text-density",
   "category": "Access",
   "command": null,
   "measurable": true
  },
  {
   "text": "Too many hard-coded colors weaken brand cohesion and contrast control.",
   "file": "h_claw-design__5.txt",
   "section": "anti-pattern-color-conflict",
   "category": "Access",
   "command": null,
   "measurable": false
  },
  {
   "text": "Reduce the palette to theme variables and keep accent colors within the approved brand range.",
   "file": "h_claw-design__5.txt",
   "section": "anti-pattern-color-conflict",
   "category": "Color",
   "command": null,
   "measurable": false
  },
  {
   "text": "Heading levels should reflect a stable information hierarchy.",
   "file": "h_claw-design__5.txt",
   "section": "anti-pattern-hierarchy-chaos",
   "category": "Type",
   "command": null,
   "measurable": false
  },
  {
   "text": "Restore heading order so sections open with h1/h2 before deeper levels.",
   "file": "h_claw-design__5.txt",
   "section": "anti-pattern-hierarchy-chaos",
   "category": "Type",
   "command": null,
   "measurable": false
  },
  {
   "text": "Repeated generic headings create a templated, low-signal result.",
   "file": "h_claw-design__5.txt",
   "section": "anti-pattern-template-trace",
   "category": "Type",
   "command": null,
   "measurable": false
  },
  {
   "text": "Replace boilerplate section names with task-specific headlines and conclusions.",
   "file": "h_claw-design__5.txt",
   "section": "anti-pattern-template-trace",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Keep density, but preserve repeatable spacing intervals and visible breathing room around major blocks.",
   "file": "h_claw-design__6.txt",
   "section": null,
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Reserve the strongest color, weight, or surface contrast for the primary headline, KPI, or action.",
   "file": "h_claw-design__6.txt",
   "section": null,
   "category": "Access",
   "command": null,
   "measurable": false
  },
  {
   "text": "Use a stable grid, shared edges, or repeated baselines unless the exception is explicit and intentional.",
   "file": "h_claw-design__6.txt",
   "section": null,
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Make the primary layer readable first, then separate supporting evidence and metadata through scale, spacing, and grouping.",
   "file": "h_claw-design__6.txt",
   "section": null,
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Use consistent spacing intervals so adjacent modules read as part of the same system.",
   "file": "h_claw-design__6.txt",
   "section": "Whitespace Rhythm",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Leave enough empty area around titles, charts, and calls to action for them to breathe.",
   "file": "h_claw-design__6.txt",
   "section": "Whitespace Rhythm",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not compress unrelated content blocks until they visually merge.",
   "file": "h_claw-design__6.txt",
   "section": "Whitespace Rhythm",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not fill every empty area with decoration or secondary copy.",
   "file": "h_claw-design__6.txt",
   "section": "Whitespace Rhythm",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Can the eye detect a repeatable spacing rhythm between sections and within sections?",
   "file": "h_claw-design__6.txt",
   "section": "Whitespace Rhythm",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Does every major block have visible breathing room on at least one side?",
   "file": "h_claw-design__6.txt",
   "section": "Whitespace Rhythm",
   "category": "Space & layout",
   "command": null,
   "measurable": true
  },
  {
   "text": "Create clear contrast between primary content, supporting content, and background surfaces.",
   "file": "h_claw-design__6.txt",
   "section": "Contrast Hierarchy",
   "category": "Access",
   "command": null,
   "measurable": false
  },
  {
   "text": "Reserve the strongest contrast for the single most important action, number, or headline.",
   "file": "h_claw-design__6.txt",
   "section": "Contrast Hierarchy",
   "category": "Access",
   "command": null,
   "measurable": true
  },
  {
   "text": "Do not let all text sit at the same visual weight.",
   "file": "h_claw-design__6.txt",
   "section": "Contrast Hierarchy",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not use accent color on too many competing elements.",
   "file": "h_claw-design__6.txt",
   "section": "Contrast Hierarchy",
   "category": "Color",
   "command": null,
   "measurable": false
  },
  {
   "text": "Can a viewer identify the first thing to read within one second?",
   "file": "h_claw-design__6.txt",
   "section": "Contrast Hierarchy",
   "category": "Content & process",
   "command": null,
   "measurable": true
  },
  {
   "text": "Are low-priority labels visibly quieter than core messages?",
   "file": "h_claw-design__6.txt",
   "section": "Contrast Hierarchy",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Match density to the artifact type: dense views must still scan cleanly, sparse views must still feel intentional.",
   "file": "h_claw-design__6.txt",
   "section": "Information Density",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Group related facts so each block answers one question instead of many.",
   "file": "h_claw-design__6.txt",
   "section": "Information Density",
   "category": "Components",
   "command": null,
   "measurable": true
  },
  {
   "text": "Do not add decorative sections that dilute the core message.",
   "file": "h_claw-design__6.txt",
   "section": "Information Density",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not stack too many unrelated ideas inside one frame or card.",
   "file": "h_claw-design__6.txt",
   "section": "Information Density",
   "category": "Space & layout",
   "command": null,
   "measurable": true
  },
  {
   "text": "Does each section have one primary job?",
   "file": "h_claw-design__6.txt",
   "section": "Information Density",
   "category": "Content & process",
   "command": null,
   "measurable": true
  },
  {
   "text": "Would removing a block improve clarity more than it hurts completeness?",
   "file": "h_claw-design__6.txt",
   "section": "Information Density",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Establish one dominant focal point per page, frame, or viewport.",
   "file": "h_claw-design__6.txt",
   "section": "Visual Focus",
   "category": "Space & layout",
   "command": null,
   "measurable": true
  },
  {
   "text": "Use scale, position, and contrast to pull attention toward the business-critical content.",
   "file": "h_claw-design__6.txt",
   "section": "Visual Focus",
   "category": "Access",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not create multiple equally loud focal points in the same viewport.",
   "file": "h_claw-design__6.txt",
   "section": "Visual Focus",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not center everything if the artifact needs directional reading.",
   "file": "h_claw-design__6.txt",
   "section": "Visual Focus",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Is the visual center obvious without reading all text?",
   "file": "h_claw-design__6.txt",
   "section": "Visual Focus",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
