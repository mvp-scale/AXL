  },
  {
   "text": "Do not give metadata the same emphasis as the headline or KPI.",
   "file": "h_claw-design__6.txt",
   "section": "Primary vs Secondary Order",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not hide critical next steps under the visual treatment of minor details.",
   "file": "h_claw-design__6.txt",
   "section": "Primary vs Secondary Order",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Can a viewer separate headline, evidence, and footnote layers at a glance?",
   "file": "h_claw-design__6.txt",
   "section": "Primary vs Secondary Order",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "If someone reads only the primary layer, do they still understand the point?",
   "file": "h_claw-design__6.txt",
   "section": "Primary vs Secondary Order",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Support high information density, but keep repeated metrics chunked into scan-friendly groups.",
   "file": "h_claw-design__6.txt",
   "section": "Primary vs Secondary Order",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Favor compact comparison modules over oversized decorative wrappers.",
   "file": "h_claw-design__6.txt",
   "section": "Primary vs Secondary Order",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not waste above-the-fold space on decorative hero treatments.",
   "file": "h_claw-design__6.txt",
   "section": "Primary vs Secondary Order",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not let KPI cards sprawl so widely that comparisons become hard.",
   "file": "h_claw-design__6.txt",
   "section": "Primary vs Secondary Order",
   "category": "Components",
   "command": null,
   "measurable": false
  },
  {
   "text": "Can a user compare KPIs in a left-to-right or top-to-bottom sweep?",
   "file": "h_claw-design__6.txt",
   "section": "Primary vs Secondary Order",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Is density serving monitoring rather than clutter?",
   "file": "h_claw-design__6.txt",
   "section": "Primary vs Secondary Order",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Place the highest-priority KPIs and alerts at the start of the natural scan path.",
   "file": "h_claw-design__6.txt",
   "section": "Dashboard Scan Path",
   "category": "Components",
   "command": null,
   "measurable": false
  },
  {
   "text": "Keep comparison widgets visually adjacent so trend reading is fast.",
   "file": "h_claw-design__6.txt",
   "section": "Dashboard Scan Path",
   "category": "Performance",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not bury urgent metrics below secondary charts.",
   "file": "h_claw-design__6.txt",
   "section": "Dashboard Scan Path",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not split tightly related metrics across distant sections.",
   "file": "h_claw-design__6.txt",
   "section": "Dashboard Scan Path",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Can an operator find the most important KPI within one sweep?",
   "file": "h_claw-design__6.txt",
   "section": "Dashboard Scan Path",
   "category": "Content & process",
   "command": null,
   "measurable": true
  },
  {
   "text": "Are alert states and trend states visually distinct?",
   "file": "h_claw-design__6.txt",
   "section": "Dashboard Scan Path",
   "category": "Interaction & states",
   "command": null,
   "measurable": false
  },
  {
   "text": "Use visual emphasis to support the data story, not to decorate the chart shell.",
   "file": "h_claw-design__6.txt",
   "section": "Data-Ink Discipline",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Keep labels, legends, and axes legible without overwhelming the plotted data.",
   "file": "h_claw-design__6.txt",
   "section": "Data-Ink Discipline",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not add ornamental gradients, shadows, or frames that compete with the marks.",
   "file": "h_claw-design__6.txt",
   "section": "Data-Ink Discipline",
   "category": "Color",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not use more highlight colors than needed to tell the comparison story.",
   "file": "h_claw-design__6.txt",
   "section": "Data-Ink Discipline",
   "category": "Color",
   "command": null,
   "measurable": false
  },
  {
   "text": "Is the main insight obvious before reading every label?",
   "file": "h_claw-design__6.txt",
   "section": "Data-Ink Discipline",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Would removing a decorative effect improve data clarity?",
   "file": "h_claw-design__6.txt",
   "section": "Data-Ink Discipline",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Make directional flow, grouping, and containment visible before the viewer reads every label.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Use connectors and containers to reduce ambiguity about relationships.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not cross connectors gratuitously when layout can avoid it.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not mix multiple relationship semantics without visual distinction.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Can the viewer trace the main path without backtracking?",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Are groups, boundaries, and dependencies visually unambiguous?",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Components",
   "command": null,
   "measurable": false
  },
  {
   "text": "Use the first viewport to establish a brand or product signal immediately.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Ensure the primary offer and action are unmistakable before scrolling.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Interaction & states",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not let decorative imagery overpower the offer.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not create a hero with no visible next-step action.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Is the offer obvious in the first viewport?",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Does the primary call to action stand out more than supporting links?",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Arrange sections so proof, explanation, and action progress in a persuasive order.",
   "file": "h_claw-design__6.txt",
   "section": "Conversion Flow",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Keep calls to action visible at natural decision points.",
   "file": "h_claw-design__6.txt",
   "section": "Conversion Flow",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not interrupt the page with unrelated visual tangents.",
   "file": "h_claw-design__6.txt",
   "section": "Conversion Flow",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not place pricing or proof so late that the page feels evasive.",
   "file": "h_claw-design__6.txt",
   "section": "Conversion Flow",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Does each section answer the next obvious buyer question?",
   "file": "h_claw-design__6.txt",
   "section": "Conversion Flow",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Are CTA placements aligned with user intent rather than filler repetition?",
   "file": "h_claw-design__6.txt",
   "section": "Conversion Flow",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Interactive elements should look interactive through position, contrast, and shape consistency.",
   "file": "h_claw-design__6.txt",
   "section": "Affordance Clarity",
   "category": "Access",
   "command": null,
   "measurable": false
  },
  {
   "text": "Tool surfaces should prioritize ergonomic grouping over ornamental composition.",
   "file": "h_claw-design__6.txt",
   "section": "Affordance Clarity",
   "category": "Components",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not style primary controls like passive labels.",
   "file": "h_claw-design__6.txt",
   "section": "Affordance Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not hide dense workflows inside decorative card stacks.",
   "file": "h_claw-design__6.txt",
   "section": "Affordance Clarity",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Can a first-time user identify primary controls without explanation?",
   "file": "h_claw-design__6.txt",
   "section": "Affordance Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do layout choices support repeated use rather than static presentation?",
   "file": "h_claw-design__6.txt",
   "section": "Affordance Clarity",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Make one message, date, or event title dominate the composition.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": true
  },
  {
   "text": "Use scale and contrast to read clearly from a distance.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Access",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not split attention equally across headline, body, and decoration.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not let long copy overpower the headline block.",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Can the core message be understood in three seconds?",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": true
  },
  {
   "text": "Is the supporting information subordinate to the hero message?",
   "file": "h_claw-design__6.txt",
   "section": "Diagram Flow Clarity",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Treat each slide as one beat in a sequence, with one message per slide.",
   "file": "h_claw-design__6.txt",
   "section": "Slide Pacing",
   "category": "Content & process",
   "command": null,
   "measurable": true
  },
  {
   "text": "Vary dense and sparse slides intentionally so the deck has rhythm.",
   "file": "h_claw-design__6.txt",
   "section": "Slide Pacing",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not let every slide share the same visual weight and density.",
   "file": "h_claw-design__6.txt",
   "section": "Slide Pacing",
   "category": "Space & layout",
   "command": null,
   "measurable": false
  },
  {
   "text": "Do not pack multiple arguments into one frame when pagination can clarify them.",
   "file": "h_claw-design__6.txt",
   "section": "Slide Pacing",
   "category": "Content & process",
   "command": null,
   "measurable": true
  },
  {
   "text": "Would a presenter know the key message of this slide immediately?",
   "file": "h_claw-design__6.txt",
   "section": "Slide Pacing",
   "category": "Content & process",
   "command": null,
   "measurable": false
  },
  {
   "text": "Does the sequence feel paced rather than monotonous?",
   "file": "h_claw-design__6.txt",
   "section": "Slide Pacing",
   "category": "Content & process",
   "command": null,
   "measurable": false
  }
 ]
