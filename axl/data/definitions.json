{
 "definitions": [
  {
   "verb": "polish",
   "plain": "Finish what is already there. Nothing off the spacing grid, nothing too faint to read, nothing you cannot reach with a keyboard. Polish never redesigns; it only removes defects that a tool can count.",
   "stays_subjective": "Whether the result feels 'refined' overall.",
