{
 "appTemplate": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>\n*{box-sizing:border-box}html{overflow:hidden}body{margin:0;background:#f5f6f8;color:#293342;font:16px/1.45 system-ui,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}button:focus,input:focus,select:focus,textarea:focus{outline:none}button{border:1px solid #cbd2db;border-radius:5px;padding:8px 12px;background:#fff;color:#334155;font-size:14px;font-weight:500}button.primary{background:#46597a;color:white;border-color:#46597a}button.secondary{background:transparent}.app{display:grid;grid-template-columns:136px minmax(0,1fr);min-height:660px}.app-nav{padding:22px 12px;border-right:1px solid #dce1e8;background:#fff;display:flex;flex-direction:column;gap:7px}.brand{font-size:18px;font-weight:700;color:#243751;padding:0 7px 25px;letter-spacing:-.4px}.brand span{display:block;font-size:12px;letter-spacing:0;font-weight:400;color:#667488}.nav-item{text-align:left;background:transparent;border:0;font-size:14px;padding:10px;border-radius:5px}.nav-item[aria-current=page]{background:#e9edf4;color:#233d60;font-weight:650}.nav-bottom{margin-top:auto;font-size:12px;padding:20px 7px;color:#697689}.workspace{padding:24px;min-width:0}.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;font-size:12px;color:#67758b}.avatar{display:inline-grid;place-items:center;background:#dfe6ef;border-radius:50%;width:28px;height:28px;font-size:11px;font-weight:600;color:#394b62}.topbar .user{display:flex;align-items:center;gap:8px}.hero{padding:0 0 16px;border-bottom:1px solid #dce1e8;background:linear-gradient(120deg,#f4f5f8,#f0f2f7);display:flex;justify-content:space-between;gap:14px;align-items:center;border-radius:4px}h1{font-size:24px;line-height:1.25;font-weight:600;letter-spacing:-.3px;color:#25384e;margin:4px 0 7px}h2{font-size:16px;color:#334155;margin:0 0 10px;font-weight:650}h3{font-size:14px;margin:0 0 5px}p{margin:0 0 12px}.subcopy{font-size:14px;color:#617085}.eyebrow{font-size:12px;color:#65758b}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.card{padding:16px;background:#fff;border:1px solid #dce1e8;border-radius:8px;box-shadow:0 2px 7px #26344908;min-width:0}.metric-label{font-size:12px;color:#657285}.metric-value{font-size:27px;line-height:1.25;font-weight:650;margin:7px 0 3px;color:#25384e;font-variant-numeric:tabular-nums}.metric-note{font-size:12px;color:#627488}section{margin-top:18px}.section-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px}.section-head h2{margin:0}.section-head span{font-size:12px;color:#6a788b}.split-grid{display:grid;grid-template-columns:1.55fr 1fr;gap:12px}.chart{width:100%;height:140px;display:block;overflow:visible}.chart-labels{font-size:11px;fill:#718097}.chart-line{stroke:#547596;fill:none;stroke-width:3}.chart-area{fill:#edf2f7}.chart-grid{stroke:#e3e8ef;stroke-width:1}.legend{font-size:12px;color:#68788d;display:flex;justify-content:space-between}.activity{list-style:none;padding:0;margin:0}.activity li{padding:10px 0;border-bottom:1px solid #e8ecf1;font-size:13px}.activity li:last-child{border:0}.activity small{display:block;font-size:11px;color:#7a8798;margin-top:3px}.data-panel{padding:0;overflow:hidden}.table-tools{display:flex;gap:8px;padding:12px;align-items:center;border-bottom:1px solid #dce1e8}.table-tools input{min-width:0;flex:1;padding:8px 10px;font-size:13px;background:#fafbfd}.table-tools select{max-width:130px;padding:8px;font-size:13px}.data-table{width:100%;border-collapse:collapse;font-size:13px;text-align:left}th{font-weight:500;font-size:11px;color:#708099;background:#fafbfd}td,th{padding:11px 12px;border-bottom:1px solid #e6eaf0}td:first-child{font-weight:550;color:#30455c}td .owner{display:flex;align-items:center;gap:6px}td .avatar{width:23px;height:23px;font-size:9px}.badge{display:inline-block;padding:3px 7px;border-radius:20px;background:#edf0f5;color:#586b83;font-size:11px;white-space:nowrap}.badge.risk{background:#fff2dd;color:#956017}.badge.done{background:#e8f3ed;color:#357250}.progress{height:5px;background:#e6ebf2;border-radius:3px;overflow:hidden;width:70px;margin-top:4px}.progress span{height:100%;display:block;background:#6983a3}.table-footer{display:flex;justify-content:space-between;font-size:11px;color:#768599;padding:10px 12px}.table-footer button{font-size:11px;padding:3px 8px}.row-action{padding:3px 7px;font-size:12px}.tabs{display:flex;gap:20px;border-bottom:1px solid #d8e0e8;margin-top:18px}.tabs button{border:0;background:transparent;border-radius:0;padding:10px 0;color:#677a8f}.tabs button[aria-selected=true]{border-bottom:2px solid #46597a;color:#263e5c}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field label{display:block;font-size:13px;margin-bottom:6px;font-weight:500}.field.wide{grid-column:1/-1}input,select,textarea{border:1px solid #c9d2de;border-radius:5px;background:#fff;color:#334155;padding:9px 10px;width:100%;font-size:14px}textarea{resize:vertical;min-height:85px}input[type=checkbox]{width:15px;height:15px;accent-color:#46597a}.help{font-size:11px;color:#7a8799;margin-top:5px}.form-actions{display:flex;justify-content:space-between;align-items:center;margin-top:20px}.form-actions small{font-size:12px;color:#78889a}.feedback{font-size:13px;margin-top:12px;min-height:0}.feedback[data-kind=error]{color:#ac382d}.feedback[data-kind=success]{color:#357250}.notice{padding:10px 12px;border:1px solid #d3ddea;background:#edf2f8;font-size:13px;border-radius:5px;display:flex;justify-content:space-between;align-items:center;gap:12px}.notice.error{border-color:#efc6c1;background:#fff2f0;color:#973930}.empty-state{text-align:center;padding:36px 18px}.empty-state p{font-size:13px;color:#77889b}.skeleton{height:12px;background:#e7ecf2;border-radius:3px;margin:12px 0}.skeleton:nth-child(2){width:68%}.loading-label{font-size:13px;color:#687c90}.switch-row{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e0e6ed;padding:15px 0;font-size:14px}.switch-row small{display:block;font-size:12px;color:#7c899a}.switch{position:relative;width:32px;height:18px;border:0;border-radius:20px;background:#c2ccd8;padding:0}.switch[aria-checked=true]{background:#46597a}.switch:after{content:'';display:block;width:14px;height:14px;background:white;border-radius:50%;position:absolute;left:2px;top:2px}.switch[aria-checked=true]:after{left:16px}.text-link{font-size:13px;color:#456485;text-decoration:underline;text-underline-offset:3px}.tip{position:relative}.tip:hover:after,.tip:focus-visible:after{content:attr(data-tooltip);position:absolute;right:0;bottom:calc(100% + 7px);width:180px;background:#25384e;color:white;font-size:12px;padding:8px;border-radius:4px;z-index:10}footer{margin-top:18px;font-size:11px;color:#8a97a8;display:flex;justify-content:space-between}.app-modal{border:1px solid #bdcad9;border-radius:8px;padding:20px;width:min(440px,90vw);color:#334155;box-shadow:0 20px 70px #16233830}.app-modal::backdrop{background:#172b4255}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.modal-head h2{margin:0}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}.modal-head button{padding:3px 8px}.project-detail{font-size:14px}.project-detail p{color:#697c92}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0}.detail-grid small{display:block;color:#78879a;font-size:11px}.disabled-example{opacity:.5;cursor:not-allowed}.toast{position:fixed;bottom:20px;right:20px;max-width:320px;background:#fff;border:1px solid #becfcb;padding:12px 16px;border-radius:6px;box-shadow:0 6px 20px #1b344522;font-size:13px;color:#32654f;z-index:30}.toast[hidden]{display:none}.panel[hidden]{display:none!important}@media(max-width:500px){.app{grid-template-columns:1fr}.app-nav{padding:12px;border-right:0;border-bottom:1px solid #dce1e8;flex-direction:row;align-items:center;gap:0;flex-wrap:wrap}.brand{padding:0 12px 0 0;font-size:16px}.brand span,.nav-bottom{display:none}.nav-item{font-size:12px;padding:8px}.workspace{padding:16px}.topbar{margin-bottom:14px}.hero{align-items:flex-start}.hero button{white-space:nowrap;font-size:12px;padding:8px}h1{font-size:23px}.cards{gap:7px}.card{padding:12px}.metric-value{font-size:23px}.metric-label,.metric-note{font-size:11px}.split-grid{grid-template-columns:1fr}.activity li:nth-child(n+3){display:none}.form-grid{grid-template-columns:1fr}.field.wide{grid-column:auto}td,th{padding:9px 7px;font-size:11px}.owner-name,.due-col{display:none}.table-tools{gap:5px;padding:8px}.table-tools select{max-width:100px}.chart{height:120px}.hero p{max-width:26ch}.tabs{gap:14px}.topbar .user span:not(.avatar){display:none}}\n</style><style id=\"recipe-style\"></style><style id=\"mark-style\"></style></head><body><div class=\"app\"><nav class=\"app-nav\" aria-label=\"Workspace\"><div class=\"brand\">Northstar<span>Project operations</span></div><button class=\"nav-item\" data-view=\"overview\" aria-current=\"page\">Overview</button><button class=\"nav-item\" data-view=\"projects\">Projects</button><button class=\"nav-item\" data-view=\"editor\">New project</button><button class=\"nav-item\" data-view=\"settings\">Settings</button><div class=\"nav-bottom\">Acme Studio<br>Team workspace</div></nav><main class=\"workspace\"><div class=\"topbar\"><span>Workspace / <span id=\"breadcrumb\">Overview</span></span><div class=\"user\"><span>Monday, 28 September</span><span class=\"avatar\">JL</span></div></div><div class=\"hero\"><div><span class=\"eyebrow\">Acme Studio</span><h1 id=\"page-title\">Team overview</h1><p class=\"subcopy\" id=\"page-copy\">A clear view of work, momentum, and what needs attention.</p></div><button class=\"primary\" data-view=\"editor\">New project</button></div><div id=\"state-banner\" style=\"margin-top:16px\" hidden></div><div class=\"panel\" id=\"overview\"><section class=\"cards\" aria-label=\"Performance\"><div class=\"card metric\"><div class=\"metric-label\">Active projects</div><div class=\"metric-value\">12</div><div class=\"metric-note\">3 launching this month</div></div><div class=\"card metric\"><div class=\"metric-label\">On-time delivery</div><div class=\"metric-value\">94.2<span style=\"font-size:16px\">%</span></div><div class=\"metric-note\">+4.1% this quarter</div></div><div class=\"card metric\"><div class=\"metric-label\">Team capacity</div><div class=\"metric-value\">78<span style=\"font-size:16px\">%</span></div><div class=\"metric-note\">Room for one new initiative</div></div></section><section class=\"split-grid\"><div class=\"card\"><div class=\"section-head\"><h2>Delivery momentum</h2><button class=\"tip secondary\" data-tooltip=\"Completed milestones each week\" aria-label=\"About delivery momentum\">i</button></div><svg class=\"chart\" viewBox=\"0 0 340 140\" role=\"img\" aria-label=\"Completed milestones rose from 8 to 21 across six weeks\"><path class=\"chart-grid\" d=\"M20 25H325M20 60H325M20 95H325\"/><path class=\"chart-area\" d=\"M20 100L81 86L142 92L203 55L264 64L325 25V118H20Z\"/><path class=\"chart-line\" d=\"M20 100L81 86L142 92L203 55L264 64L325 25\"/><g class=\"chart-labels\"><text x=\"20\" y=\"136\">W1</text><text x=\"81\" y=\"136\">W2</text><text x=\"142\" y=\"136\">W3</text><text x=\"203\" y=\"136\">W4</text><text x=\"264\" y=\"136\">W5</text><text x=\"313\" y=\"136\">W6</text></g></svg><div class=\"legend\"><span>Completed milestones</span><b>21 this week</b></div></div><div class=\"card\"><h2>Recent activity</h2><ul class=\"activity\"><li>Brand refresh approved<small>Maya Chen · 25 minutes ago</small></li><li>Platform release moved to review<small>James Lee · 1 hour ago</small></li><li>New kickoff: Customer portal<small>Olivia Ruiz · 2 hours ago</small></li></ul></div></section><section><div class=\"section-head\"><h2>Projects to watch</h2><button class=\"secondary\" data-view=\"projects\">View all projects</button></div><div class=\"card data-panel\"><table class=\"data-table\"><thead><tr><th>Project</th><th>Status</th><th>Progress</th><th></th></tr></thead><tbody id=\"overview-rows\"></tbody></table></div></section></div><div class=\"panel\" id=\"projects\" hidden><div class=\"tabs\" role=\"tablist\" aria-label=\"Project scope\"><button role=\"tab\" aria-selected=\"true\" data-scope=\"all\">All projects</button><button role=\"tab\" aria-selected=\"false\" data-scope=\"active\">Active</button><button role=\"tab\" aria-selected=\"false\" data-scope=\"review\">In review</button></div><section><div class=\"card data-panel\"><div class=\"table-tools\"><input id=\"project-search\" type=\"search\" aria-label=\"Search projects\" placeholder=\"Search projects\"><select id=\"status-filter\" aria-label=\"Filter status\"><option value=\"all\">All statuses</option><option value=\"active\">Active</option><option value=\"review\">In review</option><option value=\"risk\">At risk</option></select><button id=\"sort\" class=\"secondary\">Sort A–Z</button></div><table class=\"data-table\"><thead><tr><th>Project</th><th>Owner</th><th>Status</th><th class=\"due-col\">Due</th><th>Progress</th><th></th></tr></thead><tbody id=\"project-rows\"></tbody></table><div id=\"results-state\"></div><div class=\"table-footer\"><span id=\"results-count\"></span><div><button disabled>Previous</button><button disabled>Next</button></div></div></div></section><section class=\"notice\"><span>One project needs a delivery decision this week.</span><button data-open=\"Website migration\">Review</button></section></div><div class=\"panel\" id=\"editor\" hidden><div class=\"tabs\" role=\"tablist\" aria-label=\"Project setup\"><button role=\"tab\" data-editor-tab=\"details\" aria-selected=\"true\">Project details</button><button role=\"tab\" data-editor-tab=\"team\" aria-selected=\"false\">Team & access</button></div><section class=\"card\"><form id=\"project-form\" novalidate><div id=\"details-fields\" class=\"form-grid\"><div class=\"field wide\"><label for=\"project-name\">Project name</label><input id=\"project-name\" name=\"name\" autocomplete=\"off\" placeholder=\"e.g. Customer portal\" required><div class=\"help\">Use a name your whole team can recognize.</div></div><div class=\"field\"><label for=\"project-owner\">Project owner</label><select id=\"project-owner\"><option>James Lee</option><option>Maya Chen</option><option>Olivia Ruiz</option></select></div><div class=\"field\"><label for=\"project-date\">Target date</label><input id=\"project-date\" type=\"date\" value=\"2026-10-16\"></div><div class=\"field wide\"><label for=\"project-description\">Description</label><textarea id=\"project-description\" placeholder=\"What will this project achieve?\"></textarea></div><div class=\"field wide\"><label><input id=\"project-notify\" type=\"checkbox\" checked> Notify the team when this project is created</label></div></div><div id=\"team-fields\" hidden><h2>Workspace access</h2><p class=\"subcopy\">Choose who can see and contribute to this project.</p><div class=\"switch-row\"><span>Team visibility<small>All members of Acme Studio can view this project.</small></span><button type=\"button\" class=\"switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Team visibility\" data-setting=\"visibility\"></button></div><div class=\"switch-row\"><span>Guest contributions<small>Invited collaborators can comment.</small></span><button type=\"button\" class=\"switch\" role=\"switch\" aria-checked=\"false\" aria-label=\"Guest contributions\" data-setting=\"guests\"></button></div></div><div class=\"form-actions\"><small>Draft · not yet shared</small><div><button type=\"button\" data-view=\"projects\">Cancel</button> <button type=\"submit\" class=\"primary\" id=\"save-project\">Create project</button></div></div><div class=\"feedback\" role=\"status\" id=\"form-feedback\"></div></form></section><section><h2>Before you launch</h2><p class=\"subcopy\">Confirm the owner, scope, and delivery date with your team. You can update these after kickoff.</p><a class=\"text-link\" href=\"#\" id=\"guide\">View the kickoff checklist</a></section></div><div class=\"panel\" id=\"settings\" hidden><section class=\"card\"><h2>Workspace preferences</h2><div class=\"field\"><label for=\"workspace-name\">Workspace name</label><input id=\"workspace-name\" value=\"Acme Studio\"></div><div class=\"switch-row\"><span>Weekly summary<small>A delivery summary every Monday.</small></span><button class=\"switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Weekly summary\" data-setting=\"summary\"></button></div><div class=\"switch-row\"><span>Project alerts<small>When a milestone is blocked or overdue.</small></span><button class=\"switch\" role=\"switch\" aria-checked=\"true\" aria-label=\"Project alerts\" data-setting=\"alerts\"></button></div><div class=\"switch-row\"><span>Quiet hours<small>Pause notifications outside working hours.</small></span><button class=\"switch\" role=\"switch\" aria-checked=\"false\" aria-label=\"Quiet hours\" data-setting=\"quiet\"></button></div><div class=\"form-actions\"><small>Applies to this workspace</small><button class=\"primary\" id=\"save-settings\">Save preferences</button></div><div class=\"feedback\" id=\"settings-feedback\" role=\"status\"></div></section><section class=\"card\"><h2>Plan & access</h2><p class=\"subcopy\">Team plan · 8 of 12 seats in use</p><button id=\"invite\">Invite teammate</button> <button disabled class=\"disabled-example\">Request ownership</button></section></div><footer><span>Northstar · Acme Studio</span><span>Demo workspace</span></footer></main></div><dialog id=\"project-dialog\" class=\"app-modal\"><div class=\"modal-head\"><h2 id=\"modal-title\">Project detail</h2><button id=\"modal-close\" aria-label=\"Close project detail\">×</button></div><div id=\"modal-body\" class=\"project-detail\"></div><div class=\"modal-actions\"><button id=\"modal-dismiss\">Close</button><button class=\"primary\" id=\"modal-confirm\">Mark reviewed</button></div></dialog><div class=\"toast\" id=\"toast\" role=\"status\" hidden></div><script>\nconst $=s=>document.querySelector(s);let st={view:'overview',phase:'ready',search:'',filter:'all',scope:'all',sort:false,editorTab:'details',draft:{name:'',description:'',owner:'James Lee',date:'2026-10-16',notify:true},settings:{visibility:true,guests:false,summary:true,alerts:true,quiet:false},modal:null,toast:'',feedback:''};\nconst projects=[{name:'Customer portal',owner:'Olivia Ruiz',initials:'OR',status:'active',label:'Active',progress:62,due:'16 Oct'},{name:'Platform release',owner:'James Lee',initials:'JL',status:'review',label:'In review',progress:88,due:'2 Oct'},{name:'Website migration',owner:'Maya Chen',initials:'MC',status:'risk',label:'At risk',progress:41,due:'9 Oct'},{name:'Brand refresh',owner:'Maya Chen',initials:'MC',status:'done',label:'Complete',progress:100,due:'25 Sep'},{name:'Analytics rollout',owner:'James Lee',initials:'JL',status:'active',label:'Active',progress:27,due:'23 Oct'}];\nfunction esc(t){return String(t).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]))}function emit(){parent.postMessage({type:'lab-app-state',state:st},'*')}function rows(ps,full){return ps.map(p=>'<tr><td>'+esc(p.name)+'</td>'+(full?'<td><span class=\"owner\"><span class=\"avatar\">'+p.initials+'</span><span class=\"owner-name\">'+p.owner.split(' ')[0]+'</span></span></td>':'')+'<td><span class=\"badge '+p.status+'\">'+p.label+'</span></td>'+(full?'<td class=\"due-col\">'+p.due+'</td>':'')+'<td>'+p.progress+'%<div class=\"progress\"><span style=\"width:'+p.progress+'%\"></span></div></td><td><button class=\"row-action\" data-open=\"'+esc(p.name)+'\" aria-label=\"Open '+esc(p.name)+'\">Open</button></td></tr>').join('')}\nfunction draw(){const titles={overview:['Team overview','A clear view of work, momentum, and what needs attention.'],projects:['Projects','Track delivery, review progress, and resolve blockers.'],editor:['Create a project','Give your team a shared plan and a clear next step.'],settings:['Workspace settings','Manage access, notifications, and how your team works.']};$('#page-title').textContent=titles[st.view][0];$('#page-copy').textContent=titles[st.view][1];$('#breadcrumb').textContent={overview:'Overview',projects:'Projects',editor:'New project',settings:'Settings'}[st.view];document.querySelectorAll('.panel').forEach(p=>p.hidden=p.id!==st.view);document.querySelectorAll('[data-view]').forEach(b=>b.setAttribute('aria-current',b.dataset.view===st.view?'page':'false'));document.querySelectorAll('[data-scope]').forEach(b=>b.setAttribute('aria-selected',b.dataset.scope===st.scope));document.querySelectorAll('[data-editor-tab]').forEach(b=>b.setAttribute('aria-selected',b.dataset.editorTab===st.editorTab));$('#details-fields').hidden=st.editorTab!=='details';$('#team-fields').hidden=st.editorTab!=='team';$('#project-search').value=st.search;$('#status-filter').value=st.filter;$('#project-name').value=st.draft.name;$('#project-description').value=st.draft.description;$('#project-owner').value=st.draft.owner;$('#project-date').value=st.draft.date;$('#project-notify').checked=st.draft.notify;document.querySelectorAll('[data-setting]').forEach(b=>b.setAttribute('aria-checked',!!st.settings[b.dataset.setting]));let ps=projects.filter(p=>(st.filter==='all'||p.status===st.filter)&&(st.scope==='all'||p.status===st.scope)&&p.name.toLowerCase().includes(st.search.toLowerCase()));if(st.sort)ps.sort((a,b)=>a.name.localeCompare(b.name));let phase=st.phase;$('#overview-rows').innerHTML=phase==='empty'?'':rows(projects.slice(0,3),false);$('#project-rows').innerHTML=phase==='ready'||phase==='success'?rows(ps,true):'';$('#results-count').textContent=(phase==='empty'?0:ps.length)+' projects';$('#results-state').innerHTML=phase==='loading'?'<div style=\"padding:16px\"><div class=\"loading-label\">Loading projects…</div><div class=\"skeleton\"></div><div class=\"skeleton\"></div><div class=\"skeleton\"></div></div>':phase==='error'?'<div class=\"empty-state\"><h2>Projects could not be loaded</h2><p>Your work is safe. Try reconnecting.</p><button class=\"primary\" data-retry>Try again</button></div>':phase==='empty'||!ps.length?'<div class=\"empty-state\"><h2>No projects found</h2><p>Try another search or create your first project.</p><button data-clear>Clear filters</button> <button class=\"primary\" data-view=\"editor\">New project</button></div>':'';let banner=$('#state-banner');banner.hidden=phase==='ready';banner.innerHTML=phase==='error'?'<div class=\"notice error\"><span>Connection interrupted. Your changes are preserved.</span><button data-retry>Reconnect</button></div>':phase==='loading'?'<div class=\"notice\"><span>Syncing the latest workspace updates…</span><button disabled>Syncing</button></div>':phase==='empty'?'<div class=\"notice\"><span>This workspace has no active work yet.</span><button data-view=\"editor\">Create project</button></div>':'<div class=\"notice\"><span>Workspace updated. All changes are saved.</span><button data-retry>Dismiss</button></div>';let fb=st.feedback||(phase==='error'&&st.view==='editor'?'Unable to save. Your draft has been preserved.':phase==='success'&&st.view==='editor'?'Project created. Your team has been notified.':'');$('#form-feedback').textContent=fb;$('#form-feedback').dataset.kind=fb.includes('name')||phase==='error'?'error':'success';$('#toast').textContent=st.toast;$('#toast').hidden=!st.toast;let dlg=$('#project-dialog');if(st.modal){$('#modal-title').textContent=st.modal;let p=projects.find(p=>p.name===st.modal);$('#modal-body').innerHTML=p?'<p>Delivery overview and the next decision for your team.</p><div class=\"detail-grid\"><div><small>Owner</small>'+p.owner+'</div><div><small>Target date</small>'+p.due+'</div><div><small>Status</small>'+p.label+'</div><div><small>Completion</small>'+p.progress+'%</div></div><div class=\"notice\">'+(p.status==='risk'?'Confirm the migration window with the delivery lead.':'The owner has the next milestone in hand.')+'</div>':st.modal==='Kickoff checklist'?'<p>Agree on the scope, assign an owner, set a target date, and confirm what success looks like.</p>':'<div class=\"field\"><label for=\"invite-email\">Email address</label><input id=\"invite-email\" type=\"email\" placeholder=\"name@company.com\"></div>';if(!dlg.open)dlg.showModal()}else if(dlg.open)dlg.close();reportSize()}\nfunction reportSize(){parent.postMessage({type:'lab-size',height:document.querySelector('.app').scrollHeight+24},'*')}\ndocument.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.view){st.view=b.dataset.view;st.feedback=''}if(b.dataset.scope)st.scope=b.dataset.scope;if(b.dataset.editorTab)st.editorTab=b.dataset.editorTab;if(b.dataset.setting)st.settings[b.dataset.setting]=!st.settings[b.dataset.setting];if(b.dataset.open)st.modal=b.dataset.open;if(b.id==='sort')st.sort=!st.sort;if(b.id==='modal-close'||b.id==='modal-dismiss')st.modal=null;if(b.id==='modal-confirm'){st.modal=null;st.toast='Review recorded. Your team is up to date.'}if(b.hasAttribute('data-retry'))st.phase='ready';if(b.hasAttribute('data-clear')){st.search='';st.filter='all';st.scope='all';st.phase='ready'}if(b.id==='save-settings')st.toast='Workspace preferences saved.';if(b.id==='invite')st.modal='Invite teammate';draw();emit()});$('#guide').onclick=e=>{e.preventDefault();st.modal='Kickoff checklist';draw();emit()};$('#project-dialog').addEventListener('cancel',()=>{st.modal=null;emit()});document.addEventListener('input',e=>{let id=e.target.id;if(id==='project-search'){st.search=e.target.value;draw()}if(id==='project-name')st.draft.name=e.target.value;if(id==='project-description')st.draft.description=e.target.value;if(id==='project-date')st.draft.date=e.target.value;emit()});document.addEventListener('change',e=>{let id=e.target.id;if(id==